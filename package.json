{
  "name": "line-sticker-studio",
  "private": true,
  "version": "1.0.1",
  "type": "module",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "build:icon": "node scripts/generateOptimizedIcon.mjs",
    "build:electron": "tsc -p tsconfig.electron.json && node scripts/buildElectron.mjs",
    "build:desktop": "npm run build:electron && vite build --config vite.config.desktop.ts",
    "dev:desktop": "npm run build:electron && concurrently -k -s first \"vite\" \"electron .\"",
    "dist:win": "npm run build:desktop && electron-builder --win --config electron-builder.json5"
  },
  "dependencies": {
    "dexie": "^4.0.11",
    "jszip": "^3.10.1",
    "lucide-react": "^1.16.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^22.13.0",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.1.2",
    "cross-env": "^7.0.3",
    "electron": "^34.0.0",
    "electron-builder": "^25.1.8",
    "happy-dom": "^16.8.1",
    "postcss": "^8.5.1",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.3",
    "vite": "^6.1.0",
    "vitest": "^3.0.5"
  },
  "allowScripts": {
    "electron@34.5.8": true,
    "esbuild@0.25.12": true
  }
}
